4.10 While Loops
  "Inventory"
var STARTING_ITEMS_IN_INVENTORY = 20;

function start(){
	var numItems = STARTING_ITEMS_IN_INVENTORY;	
	
	while(numItems > 0){
	    println("We have " + numItems + " items in inventory");
	    var buy = readInt("How many would you like to buy?");
	    if (buy > numItems){
	        println("There is not enough in inventory for that purchase.");
	    } else {
	        numItems -= buy;
	        if (numItems == 0){
	            println("All out!");
	        } else {
	            println("Now we have " + numItems + " items in inventory");
	        }
	    }
	}
}
  "Fibonacci"
var MAX = 1000;

function start(){
    let F = 1;
    let S = 1;
    println(F);
    
    while (S <= MAX){
        println(S);
        let next = F + S;
        F = S;
        S = next;
    }
}

